# Required for live LLM reasoning. Without it, the governed deterministic agent fallback runs.
OPENAI_API_KEY=
# Cost/latency-oriented default with function calling and reasoning support.
OPENAI_AGENT_MODEL=gpt-5.4-mini

# Optional live external intelligence. Actor input must match the selected Actor schema.
APIFY_TOKEN=
APIFY_ACTOR_ID=compass/google-maps-reviews-scraper
APIFY_ACTOR_INPUT_JSON={"startUrls":[]}
APIFY_WEBHOOK_SECRET=replace-with-a-long-random-secret
